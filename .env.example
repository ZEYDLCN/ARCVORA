# Üretimde bu değerleri ortam değişkeni olarak verin; gerçek anahtarları depoya koymayın.
ConnectionStrings__Arcvora=Host=localhost;Database=arcvora;Username=postgres;Password=postgres
Jwt__Key=en-az-32-karakterlik-rastgele-bir-anahtar-uretin
Ai__Provider=heuristic            # heuristic (AI değil, anahtarsız) | anthropic | local
# Ai__Anthropic__ApiKey=
# Ai__Anthropic__Model=claude-sonnet-5-5
Worker__InProcess=false           # true: worker API süreci içinde çalışır (geliştirme VE tek süreçli ücretsiz dağıtım; bkz. docs/DEPLOY.md)
Database__MigrateOnStartup=false
# Yerel model (Ollama/llama.cpp/vLLM), bkz. docs/LOCAL_LLM.md
# Ai__Provider=local
# Ai__Local__BaseUrl=http://localhost:11434
# Ai__Local__Model=qwen2.5:7b-instruct
# Ai__TimeoutSeconds=1800
# Jobs__Concurrency=1

# --- Ücretsiz / tek süreçli dağıtım (docs/DEPLOY.md) ---
# DATABASE_URL=postgresql://kullanici:parola@sunucu/veritabani?sslmode=require   # verilirse ConnectionStrings__Arcvora'nın yerine geçer
# ForwardedHeaders__Enabled=true    # yalnızca bir ters proxy (Render, Fly…) ARKASINDAYKEN: istemci başına hız sınırı için
# Auth__RegistrationOpen=false      # ilk hesabı açtıktan sonra: yabancıların kayıt olmasını engeller
# Jobs__PollIntervalMs=5000         # iş kuyruğu yoklama aralığı; uyuyan/serverless veritabanını daha az uyandırır


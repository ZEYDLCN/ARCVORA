{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "Microsoft.EntityFrameworkCore.Update": "None", "Microsoft.EntityFrameworkCore.Database.Command": "None" } },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Arcvora": "Host=localhost;Database=arcvora;Username=postgres;Password=postgres" },
  "Jwt": { "Issuer": "arcvora", "Audience": "arcvora-web", "ExpiryMinutes": 480 },
  "Ai": { "Provider": "heuristic" },
  "Jobs": { "PollIntervalMs": 1000, "LeaseSeconds": 60, "Concurrency": 2 },
  "RateLimit": { "AuthPerMinute": 10 },
  "Worker": { "InProcess": false },
  "Database": { "MigrateOnStartup": false }
}
